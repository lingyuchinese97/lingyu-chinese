{
  "name": "lingyu-web-next",
  "version": "0.1.0",
  "private": true,
  "description": "LingYu Chinese — web học tiếng Trung cho người Việt (Next.js + Postgres).",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "build:migrate": "esbuild scripts/migrate.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/migrate.mjs --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "user:reset-password": "tsx --env-file-if-exists=.env scripts/reset-password.ts",
    "user:make-admin": "tsx --env-file-if-exists=.env scripts/make-admin.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/dancing-script": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@serwist/turbopack": "^9.5.12",
    "better-auth": "^1.7.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "hanzi-writer": "^3.7.3",
    "hanzi-writer-data": "^2.0.1",
    "hsk3.1-syllabus": "0.1.0",
    "lucide-react": "^1.48.0",
    "next": "^16.3.6",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pinyin-pro": "^3.29.4",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "server-only": "^0.0.1",
    "serwist": "^9.5.12",
    "sonner": "^2.0.8",
    "swagger-ui-dist": "^5.33.0",
    "tailwind-merge": "^3.7.0",
    "ts-fsrs": "^5.4.2",
    "vaul": "^1.1.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@next/env": "^16.3.6",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.1"
  }
}
