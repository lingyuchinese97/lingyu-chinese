# ============================================================
# LingYu Chinese (web-next) — biến môi trường
# Chép file này thành .env rồi điền giá trị. KHÔNG commit .env.
# ============================================================

# Kết nối Postgres.
# - Local/Docker: postgres://lingyu:lingyu@localhost:5432/lingyu
# - Neon (Vercel): dùng connection string **Pooled** (có "-pooler" trong host), thêm ?sslmode=require
DATABASE_URL=postgres://lingyu:lingyu@localhost:5432/lingyu

# Số kết nối tối đa trong pool của mỗi instance app. Neon Free nên để nhỏ (5).
DATABASE_POOL_MAX=10

# Khoá bí mật ký cookie phiên đăng nhập (≥ 32 ký tự). Tạo bằng:  openssl rand -base64 32
# Đổi khoá này sẽ đăng xuất tất cả người dùng.
BETTER_AUTH_SECRET=thay-bang-chuoi-ngau-nhien-openssl-rand-base64-32

# Địa chỉ gốc của web (không có dấu / ở cuối). Dùng cho cookie + chống CSRF.
# - Local: http://localhost:3000   - Vercel: https://ten-du-an.vercel.app   - VPS: https://lingyuchinese.com
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email được gán quyền admin khi đăng ký/đăng nhập (nhiều email cách nhau bằng dấu phẩy).
ADMIN_EMAILS=

# Mức log: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
